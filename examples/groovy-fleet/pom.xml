<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>ai.badmonkey.agentspaces</groupId>
    <artifactId>agentspaces-groovy-parent</artifactId>
    <version>0.4.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>agentspaces-example-groovy-fleet</artifactId>
  <name>AgentSpaces Groovy :: Example 21, the Groovy fleet</name>
  <description>
    Example 21: a one-file Groovy worker (worker.groovy) and a CSV-to-report
    intake script (intake.groovy) on example 02's research fleet beside Java
    peers, and a statically compiled planner class checked by FleetChecker.
    Never published.
  </description>

  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
    <skipPublishing>true</skipPublishing>
    <gpg.skip>true</gpg.skip>
    <maven.source.skip>true</maven.source.skip>
    <maven.javadoc.skip>true</maven.javadoc.skip>
  </properties>

  <dependencies>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-groovy</artifactId>
    </dependency>
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>agentspaces-groovy-concurrent</artifactId>
    </dependency>
    <!-- Example 02's entry types and its hand-wired peers, so the Groovy peers join a Java fleet. -->
    <dependency>
      <groupId>ai.badmonkey.agentspaces</groupId>
      <artifactId>example-02-research-fleet</artifactId>
      <version>${agentspaces.version}</version>
    </dependency>
    <!-- The incubating CSV and Markdown modules, used by intake.groovy only. -->
    <dependency>
      <groupId>org.apache.groovy</groupId>
      <artifactId>groovy-csv</artifactId>
    </dependency>
    <dependency>
      <groupId>org.apache.groovy</groupId>
      <artifactId>groovy-markdown</artifactId>
    </dependency>
    <!-- Table extraction in groovy-markdown is optional and needs CommonMark's GFM tables extension. -->
    <dependency>
      <groupId>org.commonmark</groupId>
      <artifactId>commonmark-ext-gfm-tables</artifactId>
      <version>0.30.0</version>
    </dependency>
    <dependency>
      <groupId>org.apache.groovy</groupId>
      <artifactId>groovy-ginq</artifactId>
    </dependency>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-api</artifactId>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>ch.qos.logback</groupId>
      <artifactId>logback-classic</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.gmavenplus</groupId>
        <artifactId>gmavenplus-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>

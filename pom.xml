<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
  <modelVersion>4.0.0</modelVersion>

  <groupId>ai.badmonkey.agentspaces</groupId>
  <artifactId>agentspaces-groovy-parent</artifactId>
  <version>0.3.0</version>
  <packaging>pom</packaging>
  <name>AgentSpaces Groovy :: Parent</name>
  <description>
    AgentSpaces for Apache Groovy 6: GDK-style extension methods on the Space
    API and the capability clients, a fleet configuration DSL that mirrors the
    starter's properties, an agent DSL bound by the Java binder through a
    generated interface, a script base class so one .groovy file is a peer,
    await-ready twins of every blocking verb, a type-checking extension, a
    shell over a running peer, and a channel bridge over the incubating
    groovy.concurrent toolkit. A standalone project on the published
    AgentSpaces libraries.
  </description>

  <url>https://github.com/badmonkeyai/agentspaces-groovy</url>
  <inceptionYear>2026</inceptionYear>

  <organization>
    <name>Bad Monkey, Inc.</name>
    <url>https://badmonkey.ai</url>
  </organization>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>albaker</id>
      <name>Al Baker</name>
      <email>al@badmonkey.ai</email>
      <organization>Bad Monkey, Inc.</organization>
      <organizationUrl>https://badmonkey.ai</organizationUrl>
      <roles>
        <role>architect</role>
        <role>developer</role>
      </roles>
    </developer>
  </developers>

  <scm child.scm.connection.inherit.append.path="false"
       child.scm.developerConnection.inherit.append.path="false"
       child.scm.url.inherit.append.path="false">
    <url>https://github.com/badmonkeyai/agentspaces-groovy</url>
    <connection>scm:git:https://github.com/badmonkeyai/agentspaces-groovy.git</connection>
    <developerConnection>scm:git:git@github.com:badmonkeyai/agentspaces-groovy.git</developerConnection>
    <tag>HEAD</tag>
  </scm>

  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/badmonkeyai/agentspaces-groovy/issues</url>
  </issueManagement>

  <properties>
    <java.version>21</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

    <agentspaces.version>0.3.0</agentspaces.version>
    <!-- Apache Groovy 6.0.0, general availability 2026-09-19. The one property
         a Groovy bump changes (SRAD GR-Q-MNT-02). -->
    <groovy.version>6.0.0</groovy.version>
    <gmavenplus-plugin.version>5.1.0</gmavenplus-plugin.version>
    <!-- Jackson 2 from the AgentSpaces BOM (CBOR codec, golden vectors). -->
    <jackson.version>2.21.7</jackson.version>
    <slf4j.version>2.0.17</slf4j.version>
    <junit.version>5.13.4</junit.version>
    <assertj.version>3.27.7</assertj.version>
    <logback.version>1.5.18</logback.version>
    <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>

    <maven-compiler-plugin.version>3.14.0</maven-compiler-plugin.version>
    <maven-surefire-plugin.version>3.5.4</maven-surefire-plugin.version>
    <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
    <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
    <maven-install-plugin.version>3.1.3</maven-install-plugin.version>
    <maven-clean-plugin.version>3.4.0</maven-clean-plugin.version>
    <maven-source-plugin.version>3.3.1</maven-source-plugin.version>
    <maven-javadoc-plugin.version>3.11.2</maven-javadoc-plugin.version>
    <maven-gpg-plugin.version>3.2.8</maven-gpg-plugin.version>
    <central-publishing-maven-plugin.version>0.9.0</central-publishing-maven-plugin.version>
  </properties>

  <modules>
    <module>groovy</module>
    <module>groovy-concurrent</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <!-- Jackson 2 ahead of every other BOM so the core's tested version wins. -->
      <dependency>
        <groupId>com.fasterxml.jackson</groupId>
        <artifactId>jackson-bom</artifactId>
        <version>${jackson.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.groovy</groupId>
        <artifactId>groovy-bom</artifactId>
        <version>${groovy.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>${junit.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.assertj</groupId>
        <artifactId>assertj-core</artifactId>
        <version>${assertj.version}</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>${logback.version}</version>
      </dependency>
      <dependency>
        <groupId>ai.badmonkey.agentspaces</groupId>
        <artifactId>agentspaces-dependencies</artifactId>
        <version>${agentspaces.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <!-- The plain-Java peer this project starts through (agentspaces-langchain4j's runtime). -->
      <dependency>
        <groupId>ai.badmonkey.agentspaces</groupId>
        <artifactId>agentspaces-runtime</artifactId>
        <version>${agentspaces.version}</version>
      </dependency>
      <dependency>
        <groupId>ai.badmonkey.agentspaces</groupId>
        <artifactId>agentspaces-groovy</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>ai.badmonkey.agentspaces</groupId>
        <artifactId>agentspaces-groovy-concurrent</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <!-- The licence and notice travel inside every jar, under META-INF. -->
      <resource>
        <directory>${maven.multiModuleProjectDirectory}</directory>
        <targetPath>META-INF</targetPath>
        <includes>
          <include>LICENSE</include>
          <include>NOTICE</include>
        </includes>
      </resource>
    </resources>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>${maven-compiler-plugin.version}</version>
          <configuration>
            <release>${java.version}</release>
            <parameters>true</parameters>
          </configuration>
        </plugin>
        <!-- Groovy sources under src/main/groovy and src/test/groovy, compiled
             by the Groovy named in the BOM. -->
        <plugin>
          <groupId>org.codehaus.gmavenplus</groupId>
          <artifactId>gmavenplus-plugin</artifactId>
          <version>${gmavenplus-plugin.version}</version>
          <executions>
            <execution>
              <goals>
                <goal>addSources</goal>
                <goal>addTestSources</goal>
                <goal>compile</goal>
                <goal>compileTests</goal>
              </goals>
            </execution>
          </executions>
          <configuration>
            <targetBytecode>${java.version}</targetBytecode>
            <parameters>true</parameters>
          </configuration>
          <dependencies>
            <dependency>
              <groupId>org.apache.groovy</groupId>
              <artifactId>groovy</artifactId>
              <version>${groovy.version}</version>
              <scope>runtime</scope>
            </dependency>
          </dependencies>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>${maven-surefire-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-resources-plugin</artifactId>
          <version>${maven-resources-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-jar-plugin</artifactId>
          <version>${maven-jar-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-install-plugin</artifactId>
          <version>${maven-install-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-clean-plugin</artifactId>
          <version>${maven-clean-plugin.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-enforcer-plugin</artifactId>
          <version>${maven-enforcer-plugin.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- The no-framework rule (SRAD GR-B-03): nothing from Micronaut, Spring,
           or LangChain4j reaches any classpath of this project, never the
           provided-scope Spring stubs, and never groovy-concurrent-java, which
           must not sit beside the full Groovy runtime. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <executions>
          <execution>
            <id>no-framework</id>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <bannedDependencies>
                  <excludes>
                    <exclude>io.micronaut*</exclude>
                    <exclude>org.springframework*</exclude>
                    <exclude>dev.langchain4j*</exclude>
                    <exclude>ai.badmonkey.agentspaces:agentspaces-spring-stubs</exclude>
                    <exclude>ai.badmonkey.agentspaces:agentspaces-spring-boot-starter</exclude>
                    <exclude>ai.badmonkey.agentspaces:agentspaces-langchain4j</exclude>
                    <exclude>org.apache.groovy:groovy-concurrent-java</exclude>
                  </excludes>
                </bannedDependencies>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!-- The example; off by default, on in CI and verify-all.sh. -->
    <profile>
      <id>examples</id>
      <modules>
        <module>examples/groovy-fleet</module>
      </modules>
    </profile>
    <!-- The host passthroughs (GR-Q-INT-03): Spring Boot and Micronaut on the classpath, by choice. -->
    <profile>
      <id>hosts</id>
      <modules>
        <module>hosts/spring-boot</module>
        <module>hosts/micronaut</module>
      </modules>
    </profile>
    <!-- Maven Central publication, the same shape as the sibling projects. -->
    <profile>
      <id>central-publish</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>${maven-source-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <phase>package</phase>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>${maven-javadoc-plugin.version}</version>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <phase>package</phase>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <quiet>true</quiet>
              <doclint>all,-missing</doclint>
              <release>${java.version}</release>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>${maven-gpg-plugin.version}</version>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
            <configuration>
              <bestPractices>true</bestPractices>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>${central-publishing-maven-plugin.version}</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
